# App
APP_FFMPEG_PATH=ffmpeg
APP_FFPROBE_PATH=ffprobe
APP_LOG_LEVEL=INFO

# Extract (PDF -> text)
EXTRACT_LLAMA_CLOUD_API_KEY=

# Translate (OpenAI, optional, enabled with --translate)
TRANSLATE_OPENAI_API_KEY=
TRANSLATE_SOURCE_LANG=en
TRANSLATE_TARGET_LANG=ru

# Merge (per-chapter MP3)
MERGE_BITRATE=128k
MERGE_SAMPLE_RATE=44100

# TTS (Soniox narration)
TTS_SONIOX_API_KEY=
TTS_MODEL=tts-rt-v1
TTS_VOICE=Maya
TTS_LANGUAGE=ru
TTS_SPEED=1.0
TTS_AUDIO_FORMAT=mp3
